# ---------------------------------------------------------------------------
# anemo configuration. Copy to `.env` and fill in the REQUIRED values.
# Everything else (providers, models, permissions, ...) is configured in the
# web UI after first login.
# ---------------------------------------------------------------------------

# REQUIRED: master key used to encrypt API keys and other secrets at rest.
# Generate with:  openssl rand -hex 32
# If you lose it you must re-enter your provider keys.
APP_SECRET_KEY=

# REQUIRED: database password (use letters/digits only, e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=

# REQUIRED: login. Prefer a hash, generated with:
#   docker compose run --rm app python -m app.cli hash-password
# Paste the printed line as-is (keep the single quotes).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Alternative to the hash (less secure; a warning is logged):
ADMIN_PASSWORD=

# Host directory mounted as the AI workspace (files agents and you can edit).
WORKSPACE_PATH=/srv/ai-workspace
# Files created in the workspace will be owned by this host user/group.
PUID=1000
PGID=1000

# Network
APP_BIND=0.0.0.0
APP_PORT=8080
# The URL you open in the browser (behind Nginx Proxy Manager).
PUBLIC_URL=https://ai.example.com
# Set to false only when accessing over plain HTTP on your LAN.
COOKIE_SECURE=true
# IP(s)/CIDRs of your reverse proxy, so client IPs are logged correctly.
# If NPM runs on the same Docker host, use its container network range, e.g. 172.16.0.0/12
TRUSTED_PROXIES=127.0.0.1

TZ=UTC

# Optional: SearXNG endpoint (can also be set in Settings > Search).
SEARXNG_URL=

# Advanced
WORKER_CONCURRENCY=4
LOG_LEVEL=INFO
