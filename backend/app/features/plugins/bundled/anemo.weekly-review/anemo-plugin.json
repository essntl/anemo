{
  "manifestVersion": 1,
  "id": "anemo.weekly-review",
  "version": "1.0.0",
  "name": "Weekly review",
  "description": "Writes a weekly review document from your open tasks and this week's events, and adds a template for writing one by hand.",
  "author": { "name": "Anemo" },
  "license": "MIT",
  "icon": "icon.png",
  "readme": "README.md",
  "permissions": ["tasks:read", "events:read", "documents:write"],
  "contributes": {
    "scripts": [
      {
        "id": "weekly-review",
        "name": "Weekly review",
        "description": "Lists your open tasks and this week's events and writes them into documents/Reviews/Week <ISO week>.md, with empty Wins and Next week sections for you to fill in.",
        "file": "scripts/weekly-review.ts",
        "tools": ["list_tasks", "list_events", "write_document"]
      }
    ],
    "templates": [
      {
        "id": "weekly-review",
        "kind": "document",
        "title": "Weekly review",
        "file": "templates/weekly-review.md"
      }
    ],
    "commands": [
      {
        "id": "run-review",
        "title": "Run weekly review",
        "icon": "notebook-pen",
        "keywords": ["review", "week", "retrospective"],
        "action": { "type": "runScript", "script": "weekly-review" }
      },
      {
        "id": "new-review",
        "title": "New weekly review from template",
        "icon": "file-plus",
        "keywords": ["review", "week", "template"],
        "action": { "type": "newFromTemplate", "template": "weekly-review" }
      }
    ]
  }
}
