# env / secrets
.env
.env.*
!.env.example

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# node
node_modules/
dist/
coverage/
frontend/src/api/schema.d.ts.bak

# local data
*.rdb
/data/
/workspace-dev/
# docker-compose.prebuilt.yml, if started from a checkout
/workspace/
/postgres/
*.log

# e2e artifacts
e2e/test-results/
e2e/playwright-report/

# throwaway test stack and local backups
e2e/.tmp/
/backups/

# A filled-in compose file for your own server (contains passwords).
*.local.yml

# Windows client (desktop/): build and publish output
desktop/**/bin/
desktop/**/obj/
desktop/publish/
# Android app (android/): build output, the local SDK path, Gradle's caches
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/.kotlin/
# The release signing key lives in repository secrets, never in the repository.
*.jks
*.keystore
