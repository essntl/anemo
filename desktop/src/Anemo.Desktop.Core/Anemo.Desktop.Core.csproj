<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that can be tested without a Windows desktop: the protocol, the
       connection, the command handlers, settings and logs. Platform calls are behind
       the interfaces in Platform/, implemented by the app project (Windows only). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Anemo.Desktop.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Anemo.Desktop.Tests" />
  </ItemGroup>

  <!-- The PowerShell parse helper (Permissions/PowerShellParser.cs): run from memory, never from a file an agent could change. -->
  <ItemGroup>
    <EmbeddedResource Include="Permissions\parse-helper.ps1" LogicalName="Anemo.Desktop.Core.Permissions.parse-helper.ps1" />
  </ItemGroup>

</Project>
