<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- For the hardened runtime that notarization needs: .NET compiles code at run time (JIT).
     Nothing else is asked for: no sandbox (the app runs the shell and Claude Code, like the
     Windows client), no camera, no microphone. Screen Recording and Accessibility are not
     entitlements: the user grants them in System Settings. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
