{
  "manifest_version": 3,
  "name": "Anemo Companion",
  "short_name": "Anemo",
  "version": "0.1.0",
  "description": "Your self-hosted Anemo workspace in the browser: chat, page context, translate and explain, capture, notes, research, focus and notifications.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Anemo",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "alarms",
    "notifications"
  ],
  "optional_permissions": [
    "declarativeNetRequest",
    "idle",
    "debugger",
    "tabs",
    "tabGroups"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open the Anemo panel"
    },
    "save-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the selection to Anemo"
    },
    "quick-task": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Create a task from this page or selection"
    }
  }
}
